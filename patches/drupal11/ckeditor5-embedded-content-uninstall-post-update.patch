+<?php
+
+/**
+ * @file
+ * Post-update functions for the legacy embedded content module.
+ */
+
+/**
+ * Uninstall after numbered updates have finished recording schema versions.
+ */
+function ckeditor5_embedded_content_post_update_uninstall_legacy_module() {
+  \Drupal::service('module_installer')->uninstall(['ckeditor5_embedded_content']);
+  return t('Uninstalled the legacy CKEditor embedded content module after migrating its configuration.');
+}
