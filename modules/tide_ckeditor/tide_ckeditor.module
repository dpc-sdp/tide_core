use Drupal\tide_ckeditor\Hook\TideCkeditorHooks;

/**
 * Implements hook_theme().
 */
#[\Drupal\Core\Hook\Attribute\LegacyHook]
function tide_ckeditor_theme($existing, $type, $theme, $path) {
  return \Drupal::service(TideCkeditorHooks::class)->theme($existing, $type, $theme, $path);
}
