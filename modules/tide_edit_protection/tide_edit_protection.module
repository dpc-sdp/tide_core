<?php

/**
 * @file
 * Contains tide_edit_protection.module.
 */

use Drupal\tide_edit_protection\Hook\TideEditProtectionHooks;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\views\ViewExecutable;

/**
 * Implements hook_help().
 */
#[\Drupal\Core\Hook\Attribute\LegacyHook]
function tide_edit_protection_help($route_name, RouteMatchInterface $route_match) {
  return \Drupal::service(TideEditProtectionHooks::class)->help($route_name, $route_match);
}

/**
 * Implements hook_form_alter().
 */
#[\Drupal\Core\Hook\Attribute\LegacyHook]
function tide_edit_protection_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  return \Drupal::service(TideEditProtectionHooks::class)->formAlter($form, $form_state, $form_id);
}

/**
 * Implements hook_form_FORM_ID_alter().
 */
#[\Drupal\Core\Hook\Attribute\LegacyHook]
function tide_edit_protection_form_views_exposed_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  return \Drupal::service(TideEditProtectionHooks::class)->formViewsExposedFormAlter($form, $form_state, $form_id);
}

/**
 * Implements hook_views_pre_view().
 */
#[\Drupal\Core\Hook\Attribute\LegacyHook]
function tide_edit_protection_views_pre_view(ViewExecutable $view, $display_id, array &$args) {
  return \Drupal::service(TideEditProtectionHooks::class)->viewsPreView($view, $display_id, $args);
}

/**
 * Implements hook_preprocess_HOOK().
 */
#[\Drupal\Core\Hook\Attribute\LegacyHook]
function tide_edit_protection_preprocess_status_messages(&$variables) {
  return \Drupal::service(TideEditProtectionHooks::class)->preprocessStatusMessages($variables);
}

/**
 * Implements hook_entity_predelete().
 *
 * @todo Follows up
 *   https://www.drupal.org/project/content_lock/issues/2951652#comment-12829088
 */
#[\Drupal\Core\Hook\Attribute\LegacyHook]
function tide_edit_protection_entity_predelete(EntityInterface $entity) {
  return \Drupal::service(TideEditProtectionHooks::class)->entityPredelete($entity);
}
