<?php

/**
 * @file
 * Tide Demo Content.
 */

use Drupal\tide_demo_content\Hook\TideDemoContentHooks;
use Drupal\Core\Entity\EntityInterface;
use Drupal\yaml_content\ContentLoader\ContentLoaderInterface;

/**
 * Implements hook_tide_demo_content_entity_imported().
 */
#[\Drupal\Core\Hook\Attribute\LegacyHook]
function tide_demo_content_tide_demo_content_entity_imported(EntityInterface $entity, $content_data, ContentLoaderInterface $content_loader) {
  return \Drupal::service(TideDemoContentHooks::class)->tideDemoContentEntityImported($entity, $content_data, $content_loader);
}

/**
 * Implements hook_entity_delete().
 */
#[\Drupal\Core\Hook\Attribute\LegacyHook]
function tide_demo_content_entity_delete(EntityInterface $entity) {
  return \Drupal::service(TideDemoContentHooks::class)->entityDelete($entity);
}

/**
 * Implements hook_config_ignore_settings_alter().
 */
#[\Drupal\Core\Hook\Attribute\LegacyHook]
function tide_demo_content_config_ignore_settings_alter(array &$settings) {
  return \Drupal::service(TideDemoContentHooks::class)->configIgnoreSettingsAlter($settings);
}
