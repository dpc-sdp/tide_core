<?php

/**
 * @file
 * Contains tide_content_collection.module.
 */

use Drupal\tide_content_collection\Hook\TideContentCollectionHooks;
use Drupal\Core\Session\AccountInterface;
use Drupal\paragraphs\ParagraphInterface;

/**
 * Implements hook_ENTITY_TYPE_access().
 */
#[\Drupal\Core\Hook\Attribute\LegacyHook]
function tide_content_collection_paragraph_access(ParagraphInterface $entity, $operation, AccountInterface $account) {
  return \Drupal::service(TideContentCollectionHooks::class)->paragraphAccess($entity, $operation, $account);
}

/**
 * Implements hook_ENTITY_TYPE_create_access().
 */
#[\Drupal\Core\Hook\Attribute\LegacyHook]
function tide_content_collection_paragraph_create_access(?AccountInterface $account = NULL, array $context = [], $entity_bundle = NULL) {
  return \Drupal::service(TideContentCollectionHooks::class)->paragraphCreateAccess($account, $context, $entity_bundle);
}
