<?php

/**
 * @file
 * Tide API module functionality.
 */

use Drupal\tide_api\Hook\TideApiHooks;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Entity\EntityTypeInterface;
use Drupal\Core\Session\AccountInterface;

/**
 * Implements hook_entity_access().
 */
#[\Drupal\Core\Hook\Attribute\LegacyHook]
function tide_api_entity_access(EntityInterface $entity, $operation, AccountInterface $account) {
  return \Drupal::service(TideApiHooks::class)->entityAccess($entity, $operation, $account);
}

/**
 * Implements hook_jsonapi_entity_filter_access().
 */
#[\Drupal\Core\Hook\Attribute\LegacyHook]
function tide_api_jsonapi_entity_filter_access(EntityTypeInterface $entity_type, AccountInterface $account) {
  return \Drupal::service(TideApiHooks::class)->jsonapiEntityFilterAccess($entity_type, $account);
}
