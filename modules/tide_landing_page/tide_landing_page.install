<?php

/**
 * @file
 * Tide Landing Page install.
 */

use Drupal\field\Entity\FieldConfig;
use Drupal\tide_landing_page\TideLandingPageOperation;
use Drupal\user\RoleInterface;

/**
 * Implements hook_install().
 */
function tide_landing_page_install() {

  // Don't do anything else during config sync.
  if (\Drupal::isConfigSyncing()) {
    return;
  }

  TideLandingPageOperation::addToWorkflows();
  TideLandingPageOperation::addToScheduledTransitions();
  TideLandingPageOperation::addWebformComponent();
  TideLandingPageOperation::assignNecessaryPermissions();
  TideLandingPageOperation::addFieldsToSearchApi();
}

/**
 * Grant CKEditor template access to Landing Page authors.
 */
function tide_landing_page_update_11001() {
  // Role dependency calculation builds URLs for filter format permissions.
  // Ensure the router cache reflects the current core routes before roles are
  // saved during a major-version database update.
  \Drupal::service('router.builder')->rebuild();

  $landing_page_permissions = [
    'create landing_page content',
    'edit any landing_page content',
    'edit own landing_page content',
  ];

  $roles = \Drupal::entityTypeManager()
    ->getStorage('user_role')
    ->loadMultiple();

  foreach ($roles as $role) {
    if (!$role instanceof RoleInterface) {
      continue;
    }

    $permissions = $role->getPermissions();
    if (in_array('insert ckeditor templates', $permissions, TRUE)) {
      continue;
    }

    if (array_intersect($landing_page_permissions, $permissions)) {
      $role->grantPermission('insert ckeditor templates');
      $role->save();
    }
  }
}

/**
 * Hero image field spelling correction.
 *
 * Update the description for the media gallery field.
 */
function tide_landing_page_update_11002() {
  $hero_caption_field = FieldConfig::load('node.landing_page.field_show_hero_image_caption');
  if ($hero_caption_field) {
    $hero_caption_field->setLabel('Show Full-width background image caption.');
    $hero_caption_field->save();
  }

  $media_gallery_field = FieldConfig::load('paragraph.media_gallery.field_paragraph_media_gallery');
  if ($media_gallery_field) {
    $description = 'New galleries can be created <a href="/admin/structure/block/block-content" target="_blank">here</a><br>Find out <a href="https://digital-vic.atlassian.net/servicedesk/customer/portal/23/article/2305426329" target="_blank">how to create an image gallery</a>';
    $media_gallery_field->setDescription($description);
    $media_gallery_field->save();
  }
}
