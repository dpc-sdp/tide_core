<?php

/**
 * @file
 * Test fixtures and hook implementations for kernel tests.
 */

use Drupal\data_pipelines\Entity\DatasetInterface;

/**
 * Implements hook_tide_data_pipeline_json_endpoint_dataset_processed().
 *
 * Records that the hook fired so kernel tests can assert on it, without
 * this test module needing to know about any real destination cleanup
 * logic (that is exercised separately by site-specific modules).
 */
function tide_data_pipeline_json_endpoint_test_tide_data_pipeline_json_endpoint_dataset_processed(DatasetInterface $dataset, string $machine_name) {
  $state = \Drupal::state();
  if ($state->get('tide_data_pipeline_json_endpoint_test.failure') === 'procedural') {
    throw new \RuntimeException('Internal destination error: private connection details');
  }
  $previous = $state->get('tide_data_pipeline_json_endpoint_test.dataset_processed', []);
  $stored = $state->get('test_push_result', []);
  $records = array_map(
    static fn ($record) => $record->getArrayCopy(),
    array_values($stored[$dataset->id()] ?? []),
  );
  $state->set('tide_data_pipeline_json_endpoint_test.dataset_processed', [
    'dataset_id' => $dataset->id(),
    'machine_name' => $machine_name,
    'records' => $records,
    'invocations' => ($previous['invocations'] ?? 0) + 1,
  ]);
}
