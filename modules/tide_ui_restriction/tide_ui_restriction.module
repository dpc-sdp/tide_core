<?php

/**
 * @file
 * Contains tide_ui_restriction.module.
 */

use Drupal\tide_ui_restriction\Hook\TideUiRestrictionHooks;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Session\AccountInterface;

/**
 * Implements hook_menu_links_discovered_alter().
 */
#[\Drupal\Core\Hook\Attribute\LegacyHook]
function tide_ui_restriction_menu_links_discovered_alter(&$links) {
  return \Drupal::service(TideUiRestrictionHooks::class)->menuLinksDiscoveredAlter($links);
}

/**
 * Implements hook_local_tasks_alter().
 */
#[\Drupal\Core\Hook\Attribute\LegacyHook]
function tide_ui_restriction_local_tasks_alter(&$local_tasks) {
  return \Drupal::service(TideUiRestrictionHooks::class)->localTasksAlter($local_tasks);
}

/**
 * Implements hook_admin_config_access_check_exclude().
 */
#[\Drupal\Core\Hook\Attribute\LegacyHook]
function tide_ui_restriction_admin_config_access_check_exclude($path): bool {
  return \Drupal::service(TideUiRestrictionHooks::class)->adminConfigAccessCheckExclude($path);
}

/**
 * Implements hook_form_FORM_ID_alter().
 */
#[\Drupal\Core\Hook\Attribute\LegacyHook]
function tide_ui_restriction_form_user_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  return \Drupal::service(TideUiRestrictionHooks::class)->formUserFormAlter($form, $form_state, $form_id);
}

/**
 * Implements hook_entity_access().
 *
 * Approver plus should not be able to edit higher roles.
 * Approver plus should not be able to cancel any account.
 */
#[\Drupal\Core\Hook\Attribute\LegacyHook]
function tide_ui_restriction_entity_access(EntityInterface $entity, $operation, AccountInterface $account) {
  return \Drupal::service(TideUiRestrictionHooks::class)->entityAccess($entity, $operation, $account);
}
