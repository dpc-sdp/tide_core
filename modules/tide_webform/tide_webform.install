<?php

/**
 * @file
 * Install file.
 */

use Drupal\tide_webform\TideOperation;

/**
 * Implements hook_install().
 */
function tide_webform_install() {
  TideOperation::installWebformConfig();
  TideOperation::accessTextEditorInWebform();
}

/**
 * Allow Webform's CodeMirror CDN assets in the SecKit CSP.
 */
function tide_webform_update_11001() {
  $config = \Drupal::configFactory()->getEditable('seckit.settings');
  if ($config->isNew()) {
    return;
  }

  $source = 'https://cdnjs.cloudflare.com/ajax/libs/codemirror/';
  $changed = FALSE;
  foreach (['script-src', 'style-src'] as $directive) {
    $key = 'seckit_xss.csp.' . $directive;
    $value = trim((string) $config->get($key));
    if ($value === '') {
      // Preserve the sources inherited from the default directive.
      $value = trim((string) $config->get('seckit_xss.csp.default-src'));
    }
    if ($value === '') {
      // Without either directive, these resources are already unrestricted.
      continue;
    }

    $sources = preg_split('/\s+/', $value, -1, PREG_SPLIT_NO_EMPTY);
    if (!in_array($source, $sources, TRUE)) {
      // The 'none' keyword cannot be combined with other sources.
      $sources = array_diff($sources, ["'none'"]);
      $sources[] = $source;
      $config->set($key, implode(' ', $sources));
      $changed = TRUE;
    }
  }

  if ($changed) {
    $config->save();
  }
}
