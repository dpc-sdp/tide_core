<?php

/**
 * @file
 * Tide tide_data_pipeline module functionality.
 */

use Drupal\tide_data_pipeline\Hook\TideDataPipelineHooks;
use Drupal\Core\Form\FormStateInterface;

/**
 * Implements hook_entity_extra_field_info().
 */
#[\Drupal\Core\Hook\Attribute\LegacyHook]
function tide_data_pipeline_entity_extra_field_info() {
  return \Drupal::service(TideDataPipelineHooks::class)->entityExtraFieldInfo();
}

/**
 * Implements hook_field_widget_single_element_form_alter().
 */
#[\Drupal\Core\Hook\Attribute\LegacyHook]
function tide_data_pipeline_field_widget_single_element_form_alter(&$element, FormStateInterface $form_state, $context) {
  return \Drupal::service(TideDataPipelineHooks::class)->fieldWidgetSingleElementFormAlter($element, $form_state, $context);
}

/**
 * Implements hook_preprocess_HOOK().
 */
#[\Drupal\Core\Hook\Attribute\LegacyHook]
function tide_data_pipeline_preprocess_form_element(&$variables) {
  return \Drupal::service(TideDataPipelineHooks::class)->preprocessFormElement($variables);
}
