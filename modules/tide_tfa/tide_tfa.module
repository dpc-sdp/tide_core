<?php

/**
 * @file
 * Contains tide_tfa.module.
 */

use Drupal\tide_tfa\Hook\TideTfaHooks;
use Drupal\Core\Form\FormStateInterface;
use Drupal\user\UserInterface;

/**
 * Implements hook_form_alter().
 */
#[\Drupal\Core\Hook\Attribute\LegacyHook]
function tide_tfa_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  return \Drupal::service(TideTfaHooks::class)->formAlter($form, $form_state, $form_id);
}

/**
 * Implements hook_menu_local_tasks_alter().
 */
#[\Drupal\Core\Hook\Attribute\LegacyHook]
function tide_tfa_menu_local_tasks_alter(&$data, $route_name, &$ref_root) {
  return \Drupal::service(TideTfaHooks::class)->menuLocalTasksAlter($data, $route_name, $ref_root);
}

/**
 * Implements hook_preprocess_HOOK().
 */
#[\Drupal\Core\Hook\Attribute\LegacyHook]
function tide_tfa_preprocess_status_messages(&$variables) {
  return \Drupal::service(TideTfaHooks::class)->preprocessStatusMessages($variables);
}

/**
 * Implements hook_user_login().
 */
#[\Drupal\Core\Hook\Attribute\LegacyHook]
function tide_tfa_user_login(UserInterface $account) {
  return \Drupal::service(TideTfaHooks::class)->userLogin($account);
}
