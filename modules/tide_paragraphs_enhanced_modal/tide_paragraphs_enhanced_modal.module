<?php

/**
 * @file
 * Module file.
 */

use Drupal\tide_paragraphs_enhanced_modal\Hook\TideParagraphsEnhancedModalHooks;

/**
 * Implements hook_theme_suggestions_HOOK().
 */
#[\Drupal\Core\Hook\Attribute\LegacyHook]
function tide_paragraphs_enhanced_modal_theme_suggestions_paragraphs_add_dialog(array $variables) {
  return \Drupal::service(TideParagraphsEnhancedModalHooks::class)->themeSuggestionsParagraphsAddDialog($variables);
}

/**
 * Implements hook_theme().
 */
#[\Drupal\Core\Hook\Attribute\LegacyHook]
function tide_paragraphs_enhanced_modal_theme($existing, $type, $theme, $path) {
  return \Drupal::service(TideParagraphsEnhancedModalHooks::class)->theme($existing, $type, $theme, $path);
}

/**
 * Implements hook_preprocess_HOOK().
 *
 * @see template_preprocess_paragraphs_add_dialog()
 */
#[\Drupal\Core\Hook\Attribute\LegacyHook]
function tide_paragraphs_enhanced_modal_preprocess_paragraphs_add_dialog(&$variables) {
  return \Drupal::service(TideParagraphsEnhancedModalHooks::class)->preprocessParagraphsAddDialog($variables);
}
