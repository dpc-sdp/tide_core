/**
 * Validation handler for the header style configuration.
 */
function _tide_core_header_style_validate(array &$form, FormStateInterface $form_state) {
  /** @var \Drupal\node\Entity\Node $node */
  $node = $form_state->getFormObject()->getEntity();
  if (!$form_state->getErrors()) {
    \Drupal::state()->set($node->uuid() . '-header_style', $form_state->getValue('_header_style_options'));
  }
}

