<?php

/**
 * @file
 * Installation functions for Tide Core.
 */

use Drupal\filter\FilterFormatInterface;
use Drupal\tide_core\TideCoreOperation;
use Drupal\user\Entity\User;
use Drupal\user\UserInterface;

/**
 * Implements hook_install().
 */
function tide_core_install() {
  // Don't do anything else during config sync.
  if (\Drupal::isConfigSyncing()) {
    return;
  }

  // Assign user 1 the "administrator" role.
  $user = User::load(1);
  $user->roles[] = 'administrator';
  $user->save();

  // Restrict user registration to admin role creation.
  \Drupal::configFactory()
    ->getEditable('user.settings')
    ->set('register', UserInterface::REGISTER_ADMINISTRATORS_ONLY)
    ->save(TRUE);

  $tideCoreOperation = new TideCoreOperation();
  // Creates terms for Topic vocabulary.
  $tideCoreOperation->createTopicTermsVocabulary();

  // Creates terms for content_category vocabulary.
  $tideCoreOperation->addContentCategoryVocabulary();

  // Update default Editorial workflow of Content Moderation.
  $tideCoreOperation->updateEditorialWorkflow();

  // Update authenticated user permission.
  $tideCoreOperation->updateAuthenticatedUserPermission();

  // Deletes unsupported actions from /admin/contents view.
  $tideCoreOperation->deleteUnsupportedActions();

  // Add business contact fields to user account form display.
  $tideCoreOperation->addBusinessFieldsToUserAccountForm();

  // Use custom files view and disable the default one.
  $tideCoreOperation->useCustomFilesView();

  // Changes the diff modules general_settings.revision_pager_limit to 16.
  $tideCoreOperation->changeDiffSettings();

  // Enable Tide TFA.
  $tideCoreOperation->enabledTideTfa();

  // Assign permissions for CKEditor template usage.
  $tideCoreOperation->assignCkeditorTemplatesPermission();

  // Enable the JSON-LD engine schema defaults (WebPage + BreadcrumbList) on the
  // node metatag default.
  $tideCoreOperation->enableJsonLdSchemaDefaults();
}

/**
 * Add CDN sources required by JavaScript components to the SecKit CSP.
 */
function tide_core_update_11002() {
  $config = \Drupal::configFactory()->getEditable('seckit.settings');
  if ($config->isNew()) {
    return;
  }

  $sources = [
    'seckit_xss.csp.script-src' => [
      'cdnjs.cloudflare.com',
      'unpkg.com',
    ],
    'seckit_xss.csp.style-src' => [
      'cdnjs.cloudflare.com',
      'unpkg.com',
    ],
    'seckit_xss.csp.img-src' => [
      'cdn.jsdelivr.net',
    ],
  ];

  $changed = FALSE;
  foreach ($sources as $key => $required_sources) {
    $current_sources = preg_split('/\s+/', trim((string) $config->get($key)), -1, PREG_SPLIT_NO_EMPTY);
    foreach ($required_sources as $required_source) {
      if (!in_array($required_source, $current_sources, TRUE)) {
        $current_sources[] = $required_source;
        $changed = TRUE;
      }
    }
    $config->set($key, implode(' ', $current_sources));
  }

  if ($changed) {
    $config->save(TRUE);
  }
}

/**
 * Ensure the JSON-LD schema modules and defaults are installed.
 */
function tide_core_update_11003() {
  (new TideCoreOperation())->enableJsonLdSchemaDefaults();
}

/**
 * Run HTML filtering before caption processing in Rich Text.
 */
function tide_core_update_11004() {
  $format = \Drupal::entityTypeManager()
    ->getStorage('filter_format')
    ->load('rich_text');
  if (!$format instanceof FilterFormatInterface) {
    return;
  }

  $filters = $format->toArray()['filters'] ?? [];
  if (!isset($filters['filter_html'])) {
    return;
  }

  $configuration = $filters['filter_html'];
  $configuration['weight'] = -51;
  $format
    ->setFilterConfig('filter_html', $configuration)
    ->save();
}

/**
 * Enable the iframe permissions filter for existing text formats.
 */
function tide_core_update_11005() {
  $configuration = [
    'id' => 'tide_ckeditor_iframe_permissions',
    'provider' => 'tide_core',
    'status' => TRUE,
    'weight' => 101,
    'settings' => [],
  ];

  $storage = \Drupal::entityTypeManager()->getStorage('filter_format');
  foreach (['rich_text', 'admin_text', 'summary_text'] as $format_id) {
    $format = $storage->load($format_id);
    if ($format instanceof FilterFormatInterface) {
      $format
        ->setFilterConfig('tide_ckeditor_iframe_permissions', $configuration)
        ->save();
    }
  }
}
